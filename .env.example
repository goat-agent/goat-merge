# The https address GitHub will reach this server on. Everything else is derived from it:
# the webhook, the OAuth callback, the setup redirect.
GOAT_MERGE_PUBLIC_URL=https://merge.example.com

# Encrypts the GitHub App private key, the webhook secret and every session before they are
# written down. It has to survive restarts, so keep it somewhere. Make one with:
#   openssl rand -hex 32
GOAT_MERGE_MASTER_KEY=

# Optional. The compose file builds DATABASE_URL from this.
POSTGRES_PASSWORD=goat

# Optional. Which port to publish the console and webhook endpoint on.
GOAT_MERGE_PORT=8080

# Optional. Which port to publish PostgreSQL on, if you want to reach it from your machine.
POSTGRES_PORT=5432
